// Cloudflare Workers with static assets.
// `astro build` writes the static site to dist/client and the Worker to dist/server, plus a
// generated dist/server/wrangler.json derived from this file, which `wrangler dev` and
// `wrangler deploy` pick up automatically.
// Production runs as the Worker "sivak-ai" on workers.dev only (no routes, no custom domain yet);
// there every response is noindex (src/worker.ts, public/_headers). See README.md → "Deploy and cutover".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sivak-ai",
  // Wraps Astro's handler: the language redirect on "/" runs before the static assets
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // https://sivak-ai.onfire4yhwh.workers.dev until the cutover; no "routes" on purpose
  "workers_dev": true,

  "assets": {
    "binding": "ASSETS",
    // "/en" serves en.html, "/en/" redirects to "/en" — the same URLs as the Next.js site
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Static files are served without invoking the Worker, except:
    //  - where the Worker decides the language: "/" (browser language, cookie), "/en" (?lang= switch),
    //    "/en/" (308 to "/en" as before) and the old "/cs" URLs;
    //  - the on-demand routes. Without them here, browser navigations to /admin/… would get the 404 page;
    //  - /robots.txt, which the Worker answers with "Disallow: /" on *.workers.dev only.
    "run_worker_first": ["/", "/en", "/en/", "/cs", "/cs/*", "/api/*", "/admin/*", "/robots.txt"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sivak-ai",
      // Created in WEUR; migrations/0001 is applied remotely. Local development (`--local`,
      // `npm run dev`, `npm run preview`) uses a local copy in .wrangler/state, never this database.
      "database_id": "73a4d2d1-d42a-4b19-a853-463ee16dc1dd",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret settings. Secrets (TURNSTILE_SECRET_KEY, IP_HASH_SALT, ADMIN_USER, ADMIN_PASSWORD) are
  // set with `wrangler secret put` in production and in .dev.vars locally — see .dev.vars.example.
  // No Turnstile test key belongs here: production refuses them.
  "vars": {
    // "production" makes the form refuse to skip Turnstile; .dev.vars sets "development"
    "SITE_ENV": "production",
    "ENQUIRY_NOTIFY_TO": "mirek@sivak.ai,matous@sivak.ai",
    // Sender on sivak.ai, which is onboarded for Cloudflare Email Sending (shown as "sivak.ai – poptávky")
    "ENQUIRY_FROM_EMAIL": "web@sivak.ai",
    "NOTIFY_DISABLED": "0"
  },

  // Cloudflare Email Service, the only notification channel (src/lib/server/notify.ts). sivak.ai is
  // onboarded for Email Sending (return path cf-bounce.sivak.ai, DKIM selector cf-bounce); MX stays on
  // Google. No destination-address verification and no Email Routing are needed. The binding may only
  // write to these two addresses; the recipients themselves come from ENQUIRY_NOTIFY_TO.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["mirek@sivak.ai", "matous@sivak.ai"]
    }
  ],

  "observability": { "enabled": true },

  // Hourly retention cleanup (src/worker.ts → scheduled): rate-limit attempts after a day,
  // enquiries after 24 months, as the privacy policy says
  "triggers": { "crons": ["0 * * * *"] },

  "env": {
    // Noindexed copy for review on workers.dev: `npm run deploy:preview` builds with
    // CLOUDFLARE_ENV=preview and deploys the Worker "ai-skoleni-nahled". Bindings and vars are not
    // inherited from the top level, so they are repeated here; there is deliberately no send_email.
    "preview": {
      "name": "ai-skoleni-nahled",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        // Every request goes through the Worker, which adds X-Robots-Tag and the robots meta tag
        // and answers robots.txt with "Disallow: /". Fine for a preview, too slow for production.
        "run_worker_first": true
      },
      // Its own database (WEUR), so test enquiries never reach production's. Migrations:
      // `npm run db:migrate:preview` (see README → Database changes)
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ai-skoleni-nahled",
          "database_id": "ea98bf57-da85-4cd6-8a0a-cea4175f9713",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["0 * * * *"] },
      // Secrets of this Worker (`wrangler secret put NAME --env preview`): IP_HASH_SALT (required,
      // the form refuses submissions without it), ADMIN_USER and ADMIN_PASSWORD (for the admin)
      "vars": {
        // Turnstile test keys allowed, no e-mail, enquiries stored with source "ai-skoleni-preview"
        "SITE_ENV": "preview",
        "ENQUIRY_NOTIFY_TO": "mirek@sivak.ai,matous@sivak.ai",
        "ENQUIRY_FROM_EMAIL": "",
        "NOTIFY_DISABLED": "1",
        // Cloudflare's public always-pass test secret (not a secret); production refuses it
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      }
    }
  }
}
