# Public, build-time values (inlined into the static pages by `astro build`).
# Copy to .env (gitignored) locally; in Cloudflare Workers Builds set them as build variables.

# Cloudflare Turnstile site key for the enquiry dialog (src/components/site/EnquiryDialog.astro). Public:
# it ends up in every page's HTML. Empty in a build (`astro build`) = the dialog shows the e-mail address
# instead of the form, and the build logs a warning; only `astro dev` keeps the form without the widget.
# Production: the site key of the sivak.ai Turnstile widget, set as a build variable in Workers Builds.
# Local / screenshots / preview only: Cloudflare's always-pass visible test key 1x00000000000000000000AA
# (production refuses its token).
PUBLIC_TURNSTILE_SITE_KEY=

