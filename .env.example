# Public, build-time values (inlined into the static pages by `astro build`).
# Copy to .env (gitignored) locally; in Cloudflare Workers Builds set them as build variables.

# Cloudflare Turnstile site key. Empty = no widget on the form (and production then refuses submissions
# until TURNSTILE_SECRET_KEY is set too). Cloudflare's always-pass test key: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# Google Ads conversion, fired after a successful enquiry. Both must be set, otherwise nothing is sent.
# PUBLIC_GOOGLE_ADS_ID is the tag ID "AW-123456789" from Google Ads → Goals → Conversions → (action) → Tag setup.
# It is NOT the customer ID shown in the Google Ads UI (285-124-8637).
PUBLIC_GOOGLE_ADS_ID=
# The label after the slash in send_to "AW-123456789/AbCdEfGhIjKlMnOp"
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
