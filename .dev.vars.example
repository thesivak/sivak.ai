# Worker variables and secrets for local development (`npm run dev`, `npm run preview`).
# Copy to .dev.vars (gitignored) and fill in what you need. Everything is optional locally.
# In production, set the secrets with `wrangler secret put NAME`; the non-secret values live in wrangler.jsonc → vars.

# "development" (local) or "preview" (the noindexed workers.dev copy, see wrangler.jsonc env.preview):
# Turnstile may be skipped when its secret is missing or use the test keys, and e-mail is never sent (logged instead).
# "production" (the default in wrangler.jsonc) requires real Turnstile keys.
# Outside development a failing rate limit refuses the submission (503); development lets it through.
SITE_ENV=development

# Admin at /admin/poptavky (HTTP Basic auth). ADMIN_PASSWORD needs at least 24 characters
# (e.g. `openssl rand -base64 24`); missing or shorter, the admin answers 503 "Admin not configured."
ADMIN_USER=
ADMIN_PASSWORD=

# Cloudflare Turnstile secret key (the site key is PUBLIC_TURNSTILE_SITE_KEY in .env).
# Cloudflare's test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# HMAC key for the visitor IP hash (rate limit, ip_hash column), e.g. `openssl rand -hex 32`.
# Required in production and preview: without it the form answers 503 and stores nothing.
# With SITE_ENV=development it may be empty: then there is no rate limit and ip_hash is NULL (logged warning).
IP_HASH_SALT=

# The D1 binding DB is required in every mode: without it the form answers 503 (never a fake success).
# Create the local tables with `npm run db:migrate:local`.

# E-mail notification via the Cloudflare Email Service binding EMAIL (wrangler.jsonc). Never sent
# while SITE_ENV=development; `wrangler dev` only simulates the binding anyway.
ENQUIRY_FROM_EMAIL=
ENQUIRY_NOTIFY_TO=mirek@sivak.ai,matous@sivak.ai
# 1 = never send, log only (kill switch)
NOTIFY_DISABLED=1
