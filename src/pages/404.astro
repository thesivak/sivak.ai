---
import "@/styles/site-fonts.css";
import "@/styles/site.css";
import Document from "@/layouts/Document.astro";
import BrandLogo from "@/components/BrandLogo.astro";

// Served by Cloudflare for every unknown URL (assets.not_found_handling = "404-page"), in both languages
---
<Document
  lang="cs"
  title="Stránka nenalezena – sivak.ai"
  description="Tato stránka neexistuje. Pokračujte na úvodní stránku sivak.ai."
  ogImage={{ path: "/og/cs.png?v=4", alt: "sivak.ai" }}
  robots="noindex"
  preloadFonts={["archivo-latin-wdth-normal", "archivo-latin-ext-wdth-normal"]}
  themeColor="#F4F5F2"
>
  <main id="main" class="band not-found">
    <div class="wrap">
      <a class="not-found-logo" href="/" aria-label="sivak.ai – úvod"><BrandLogo /></a>
      <h1 class="display display-2">Tuhle stránku nemáme</h1>
      <p class="lead">Odkaz je možná starý nebo v něm je překlep.</p>
      <p class="lead" lang="en">This page does not exist. The link may be old or mistyped.</p>
      <div class="actions">
        <a class="btn" href="/">Na úvodní stránku</a>
        <a class="link" href="/en" hreflang="en" lang="en" data-lang-switch="en">Go to the English home page</a>
      </div>
    </div>
  </main>
</Document>

<style>
  .not-found { min-height: 100svh; }
  .not-found-logo { display: inline-flex; margin-bottom: 64px; color: var(--ink); }
  .not-found-logo :global(svg) { height: 28px; width: auto; }
  .not-found .lead { margin-top: 20px; }
  .not-found .lead + .lead { margin-top: 8px; }
</style>
