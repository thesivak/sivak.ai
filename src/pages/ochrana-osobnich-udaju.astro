---
import Base from "@/layouts/Base.astro";
import BrandLogo from "@/components/BrandLogo.astro";
import { czechSpacingHtml } from "@/lib/czech";
import { COOKIE_CONSENT_KEY, COOKIE_CONSENT_MONTHS, TRACKING_STORAGE_KEY } from "@/lib/consent";
import { GA_MEASUREMENT_ID, PRIVACY_CONTACT_EMAIL } from "@/lib/site";
import { LIMIT, WINDOW_MS } from "@/lib/server/rate-limit";
import { ENQUIRY_RETENTION_MONTHS } from "@/lib/server/store";

// DRAFT for Mirek's legal check: not final until every [DOPLNIT: …] is filled in and a lawyer has read it.
// One placeholder remains: the Google Analytics data retention (Mirek's setting in GA).
// Kept out of search engines (noindex) until then. Linked from the form via PRIVACY_POLICY_URL.
// It describes what the code does; change both together:
//  - fields and columns: src/lib/enquiry/fields.ts, src/lib/server/store.ts, migrations/
//  - rate limit and retention: src/lib/server/rate-limit.ts, src/lib/server/store.ts (pruneEnquiries),
//    the hourly cron in src/worker.ts; notification e-mails are deleted by hand (README → Retention)
//  - Turnstile, notification e-mails: src/lib/server/turnstile.ts, src/lib/server/notify.ts
//  - Google Analytics on every page (src/layouts/Base.astro) under Google Consent Mode v2, with the cookie
//    banner (src/components/CookieConsent.astro, src/lib/consent.ts); the Google Ads parts are shown only
//    when PUBLIC_GOOGLE_ADS_ID is set at build time, as the Ads tag itself
//  - the `lang` cookie (src/lib/routing.ts, src/components/language-hint.ts), sessionStorage (src/components/landing/enquiry-form.ts,
//    written only with marketing consent), the consent record in localStorage (src/lib/consent.ts)
// Controller details as verified by Mirek in ARES and the commercial register on 27 October 2026.
// Notifications: Cloudflare Email Service (src/lib/server/notify.ts) into Google Workspace mailboxes.
// Open legal point for Mirek: the Google Analytics retention setting.
// The form's checkbox is an acknowledgement, not consent (CONSENT_VERSION in fields.ts).
const contact = PRIVACY_CONTACT_EMAIL;
const ads = Boolean(import.meta.env.PUBLIC_GOOGLE_ADS_ID);
const windowMinutes = WINDOW_MS / 60_000;
const mail = `<a href="mailto:${contact}">${contact}</a>`;

const html = `
<p>Tyto zásady popisují, jak zpracováváme osobní údaje návštěvníků webu www.sivak.ai, především údaje
z poptávkového formuláře na stránce <a href="/ai-skoleni">AI školení pro firmy</a>.</p>

<h2>Kdo údaje zpracovává</h2>
<p>Správcem osobních údajů je TheSivak s.r.o., IČO 23010282, se sídlem Bohdíkovská 2208/90, 787 01 Šumperk,
zapsaná v obchodním rejstříku vedeném Krajským soudem v Ostravě, oddíl C, vložka 98925, která vystupuje pod
značkou sivak.ai (dále „my“).</p>
<p>S dotazy ke zpracování osobních údajů a s uplatněním svých práv se obracejte na e-mail ${mail}.</p>

<h2>Jaké údaje zpracováváme</h2>
<h3>Údaje z poptávkového formuláře</h3>
<ul>
  <li>jméno a příjmení, firma a e-mail (povinné),</li>
  <li>telefon, počet účastníků a poznámka nebo preferovaný termín (nepovinné),</li>
  <li>čas odeslání a verze textu u zaškrtávacího pole, které jste potvrdili.</li>
</ul>
<h3>Odkud jste na stránku přišli</h3>
<ul>
  <li>parametry kampaně z adresy stránky (utm_source, utm_medium, utm_campaign, utm_term, utm_content),</li>
  <li>identifikátor kliknutí na reklamu Google (gclid), pokud ho adresa obsahuje,</li>
  <li>adresa stránky, na kterou jste na web přišli (cesta a parametry, bez domény).</li>
</ul>
<p>Tyto údaje připojí k poptávce váš prohlížeč, nebo je čteme z adresy předchozí stránky, kterou prohlížeč
posílá s formulářem.</p>
<h3>Technické údaje</h3>
<ul>
  <li>identifikace prohlížeče (user agent), uložená s poptávkou;</li>
  <li>otisk IP adresy: IP adresu samotnou neukládáme, jen její otisk vytvořený klíčovanou hašovací funkcí
    (HMAC-SHA256 s tajným klíčem), ze kterého IP adresu bez klíče zjistit nelze. Ukládáme ho s poptávkou
    a pro omezení počtu odeslání také s časem každého pokusu o odeslání formuláře;</li>
  <li>údaje, které zpracovává ochrana formuláře Cloudflare Turnstile: technické údaje o prohlížeči
    a zařízení a IP adresa, podle kterých služba rozpozná automatizované odesílání. Ověřovací token
    a IP adresu předáváme Cloudflare k ověření; výsledek si neukládáme.</li>
</ul>
<h3>Měření návštěvnosti${ads ? " a reklam" : ""} – jen s vaším souhlasem</h3>
<p>Na stránkách webu je značka Google Analytics 4 (${GA_MEASUREMENT_ID}). Cookies ukládá a návštěvu měří jen
tehdy, když s analytickými cookies souhlasíte v liště cookies. Google pak zpracovává údaje o návštěvě –
například zobrazené stránky, typ zařízení a prohlížeče a přibližnou polohu odvozenou z IP adresy.
Bez souhlasu běží značka v režimu Google Consent Mode: cookies neukládá ani nečte a Google od ní může
dostávat jen základní technické údaje o zobrazení stránky bez identifikátorů z cookies.</p>
${
  ads
    ? `<p>Na stránce AI školení měříme se souhlasem s marketingovými cookies také konverze z reklam Google Ads:
po úspěšném odeslání poptávky prohlížeč pošle Google Ads informaci, že konverze proběhla. Bez tohoto souhlasu
se konverze neodesílá. Obsah formuláře Googlu nepředáváme.</p>`
    : ""
}

<h2>Proč a na jakém právním základě</h2>
<ul>
  <li><strong>Vyřízení poptávky</strong> – ozveme se vám, domluvíme program, termín a nabídku. Právním
    základem je čl. 6 odst. 1 písm. b) GDPR: provedení opatření přijatých před uzavřením smlouvy na vaši
    žádost. Údaje poskytujete dobrovolně; bez jména, firmy a e-mailu ale poptávku vyřídit nemůžeme.</li>
  <li><strong>Vyhodnocení, odkud poptávky přicházejí</strong> (parametry kampaně, gclid, vstupní stránka) –
    oprávněný zájem na vyhodnocení naší propagace, čl. 6 odst. 1 písm. f) GDPR.</li>
  <li><strong>Ochrana formuláře před zneužitím a spamem</strong> (Turnstile, omezení počtu odeslání,
    otisk IP adresy, identifikace prohlížeče) – oprávněný zájem na bezpečném provozu webu, čl. 6 odst. 1
    písm. f) GDPR.</li>
  <li><strong>Zapamatování zvoleného jazyka</strong> (cookie lang) – oprávněný zájem na fungování
    přepínače jazyka, čl. 6 odst. 1 písm. f) GDPR.</li>
  <li><strong>Měření návštěvnosti${ads ? " a konverzí z reklam" : ""}</strong> (analytické${ads ? " a marketingové" : ""} cookies,
    Google Analytics${ads ? ", Google Ads" : ""}) – váš souhlas podle § 89 odst. 3 zákona č. 127/2005 Sb.,
    o elektronických komunikacích, a čl. 6 odst. 1 písm. a) GDPR. Souhlas dáváte v liště cookies zvlášť
    pro analytické a pro marketingové cookies a můžete ho kdykoli odvolat (viz Cookies a úložiště v prohlížeči).
    Odvolání se netýká zpracování před ním.</li>
  <li><strong>Uložení vaší volby v liště cookies</strong> – nezbytné pro fungování lišty, ukládá se jen ve vašem
    prohlížeči (§ 89 odst. 3 zákona o elektronických komunikacích, výjimka pro nezbytné ukládání).</li>
</ul>
<p>Zaškrtávací pole ve formuláři potvrzuje, že jste se s těmito zásadami seznámili; nejde o souhlas se
zpracováním. Proti zpracování na základě oprávněného zájmu můžete vznést námitku (viz Vaše práva).
Automatizované rozhodování ani profilování neprovádíme.</p>

<h2>Jak dlouho údaje uchováváme</h2>
<ul>
  <li><strong>Poptávky</strong> v databázi formuláře uchováváme ${ENQUIRY_RETENTION_MONTHS} měsíců od odeslání,
    potom je automaticky mažeme. E-mailová oznámení o poptávce mažeme ze schránek ve stejné lhůtě.
    Pokud z poptávky vznikne smlouva, údaje potřebné k jejímu plnění převezmeme do smluvní dokumentace
    a uchováváme je po dobu trvání smlouvy a po dobu, kterou nám ukládají právní předpisy (například
    účetní a daňové).</li>
  <li><strong>Záznamy pro omezení počtu odeslání</strong> (otisk IP adresy a čas pokusu) mažeme nejpozději
    po 24 hodinách. Formulář přijme z jedné IP adresy nejvýše ${LIMIT} odeslání za ${windowMinutes} minut.</li>
  <li><strong>Cookies a úložiště v prohlížeči</strong>: podle tabulky níže.</li>
  <li><strong>Údaje o návštěvách v Google Analytics</strong>: [DOPLNIT: doba uchování nastavená ve službě].</li>
</ul>

<h2>Cookies a úložiště v prohlížeči</h2>
<p>Nezbytné položky ukládáme bez souhlasu, ostatní jen s ním. Při první návštěvě se vás zeptáme v liště cookies;
obě volby – přijmout i odmítnout – jsou stejně snadné. Souhlas platí ${COOKIE_CONSENT_MONTHS} měsíců, potom se
zeptáme znovu.</p>
<div class="privacy-table"><table>
  <thead><tr><th scope="col">Název</th><th scope="col">Účel</th><th scope="col">Poskytovatel</th><th scope="col">Platnost</th><th scope="col">Kdy</th></tr></thead>
  <tbody>
    <tr><td>${COOKIE_CONSENT_KEY} (úložiště localStorage)</td><td>vaše volba v liště cookies: kategorie, verze lišty a čas volby</td><td>sivak.ai</td><td>${COOKIE_CONSENT_MONTHS} měsíců</td><td>vždy, nezbytné</td></tr>
    <tr><td>lang (cookie)</td><td>zvolený jazyk webu</td><td>sivak.ai</td><td>1 rok</td><td>jen po přepnutí jazyka, nezbytné</td></tr>
    <tr><td>${TRACKING_STORAGE_KEY} (úložiště sessionStorage)</td><td>parametry kampaně z adresy, na kterou jste přišli, aby se připojily k poptávce i po přechodu mezi stránkami</td><td>sivak.ai</td><td>do zavření okna nebo odeslání poptávky</td><td>jen se souhlasem s marketingovými cookies</td></tr>
    <tr><td>_ga</td><td>rozlišení návštěvníků v Google Analytics</td><td>Google</td><td>2 roky</td><td>jen se souhlasem s analytickými cookies</td></tr>
    <tr><td>_ga_${GA_MEASUREMENT_ID.replace(/^G-/, "")}</td><td>stav návštěvy v Google Analytics</td><td>Google</td><td>2 roky</td><td>jen se souhlasem s analytickými cookies</td></tr>
${
  ads
    ? `    <tr><td>_gcl_au</td><td>měření konverzí z reklam Google Ads</td><td>Google</td><td>90 dní</td><td>jen se souhlasem s marketingovými cookies</td></tr>
    <tr><td>_gcl_aw</td><td>identifikátor kliknutí na reklamu, pokud jste přišli z reklamy Google</td><td>Google</td><td>90 dní</td><td>jen se souhlasem s marketingovými cookies</td></tr>`
    : ""
}
  </tbody>
</table></div>
<p><strong>Jak souhlas změnit nebo odvolat:</strong> odkazem Nastavení cookies v patičce webu<span
class="privacy-cookies-here" data-cookie-settings-wrap hidden>, nebo zde: <button type="button" class="privacy-cookies" data-cookie-settings>otevřít nastavení cookies</button></span>.
Po odvolání přestaneme Google Analytics${ads ? " a Google Ads" : ""} používat a cookies _ga, _ga_*${ads ? " a _gcl_*" : ""}
z vašeho prohlížeče smažeme.</p>

<h2>Kdo k údajům má přístup</h2>
<p>Poptávky vidí jen naši pracovníci, kteří je vyřizují. Údaje neprodáváme a nepředáváme je dalším
subjektům, kromě těchto zpracovatelů a příjemců:</p>
<ul>
  <li><strong>Cloudflare, Inc.</strong> – provoz webu (Cloudflare Workers), databáze poptávek (Cloudflare D1,
    vytvořená v regionu západní Evropa), ochrana formuláře (Cloudflare Turnstile) a odesílání e-mailových
    oznámení o nové poptávce (Cloudflare Email Service). Oznámení obsahují údaje z formuláře a souhrn
    parametrů kampaně;</li>
  <li><strong>Google (Google Workspace)</strong> – e-mailové schránky našich pracovníků, do kterých oznámení
    o poptávkách přicházejí;</li>
  <li><strong>Google Ireland Limited a Google LLC</strong> – Google Analytics${ads ? " a Google Ads" : ""}.</li>
</ul>

<h2>Předávání mimo EU</h2>
<p>Cloudflare a Google jsou součástí skupin se sídlem v USA, a údaje proto mohou být zpracovány i mimo
Evropskou unii a Evropský hospodářský prostor. Takové předání se opírá o rozhodnutí Evropské komise
o odpovídající ochraně údajů pro společnosti zapojené do EU-U.S. Data Privacy Framework, případně o standardní
smluvní doložky schválené Evropskou komisí.</p>

<h2>Vaše práva</h2>
<p>Podle GDPR máte právo:</p>
<ul>
  <li>na přístup ke svým osobním údajům (čl. 15),</li>
  <li>na opravu nepřesných údajů (čl. 16),</li>
  <li>na výmaz (čl. 17),</li>
  <li>na omezení zpracování (čl. 18),</li>
  <li>na přenositelnost údajů (čl. 20),</li>
  <li>vznést námitku proti zpracování na základě oprávněného zájmu (čl. 21),</li>
  <li>kdykoli odvolat souhlas s analytickými a marketingovými cookies (čl. 7 odst. 3), odkazem Nastavení cookies v patičce,</li>
  <li>podat stížnost u Úřadu pro ochranu osobních údajů (<a href="https://www.uoou.cz/" rel="noopener">www.uoou.cz</a>).</li>
</ul>
<p>Svá práva uplatníte e-mailem na ${mail}. Odpovíme bez zbytečného odkladu, nejpozději do jednoho měsíce.</p>

<h2>Účinnost</h2>
<p>Tyto zásady jsou účinné od 27. 10. 2026.</p>
`;
---
<Base
  lang="cs"
  title="Zásady zpracování osobních údajů – sivak.ai"
  description="Jak sivak.ai zpracovává osobní údaje návštěvníků webu a z poptávkového formuláře."
  ogImage={{ path: "/og/cs.png", alt: "sivak.ai" }}
  robots="noindex"
>
  <main id="main" class="section light privacy">
    <div class="container">
      <a class="privacy-logo" href="/" aria-label="sivak.ai – úvod"><BrandLogo /></a>
      <h1 class="section-title">Zásady zpracování osobních údajů</h1>
      <div class="privacy-body" set:html={czechSpacingHtml(html)} />
    </div>
  </main>
</Base>

<style>
  .privacy { min-height: 100svh; }
  .privacy-logo { display: inline-flex; margin-bottom: 48px; color: var(--ink); }
  .privacy-logo :global(svg) { height: 28px; width: auto; }
  .privacy-body { max-width: 760px; margin-top: 32px; font-size: 17px; line-height: 1.65; color: var(--ink-2); }
  .privacy-body :global(h2) { margin: 48px 0 12px; font-size: 24px; font-weight: 500; line-height: 1.25; color: var(--ink); }
  .privacy-body :global(h3) { margin: 28px 0 8px; font-size: 18px; font-weight: 500; color: var(--ink); }
  .privacy-body :global(p), .privacy-body :global(ul) { margin: 0 0 14px; }
  .privacy-body :global(ul) { padding-left: 22px; list-style: disc; }
  .privacy-body :global(li) { margin: 6px 0; }
  .privacy-body :global(a) { color: var(--ink); text-underline-offset: 3px; }
  .privacy-body :global(strong) { font-weight: 500; color: var(--ink); }
  .privacy-body :global(.privacy-table) { overflow-x: auto; margin: 0 0 14px; }
  .privacy-body :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.45; }
  .privacy-body :global(th), .privacy-body :global(td) { padding: 8px 10px; border-bottom: 1px solid var(--line-strong); text-align: left; vertical-align: top; }
  .privacy-body :global(th) { font-weight: 500; color: var(--ink); }
  .privacy-body :global(.privacy-cookies) { padding: 0; border: 0; background: none; font: inherit; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .privacy-body :global(.privacy-cookies-here[hidden]) { display: none; }
</style>
