---
import "@/styles/fonts.css";
import "@/styles/global.css";
import CookieConsent from "@/components/CookieConsent.astro";
import LanguageHint from "@/components/LanguageHint.astro";
import type { Locale } from "@/i18n/config";
import { consentHeadSnippet } from "@/lib/consent";
import { GA_MEASUREMENT_ID, SITE_URL } from "@/lib/site";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Absolute canonical URL; also used as og:url */
  canonical?: string;
  alternates?: { hreflang: string; href: string }[];
  ogImage: { path: string; alt: string };
  ogTitle?: string;
  ogDescription?: string;
  /** e.g. "noindex" for pages that should stay out of search */
  robots?: string;
  jsonLd?: object[];
  /** URL of this page in the other language, for the "Switch to English" suggestion (pages with a twin) */
  languageTwin?: string;
}

const { lang, title, description, canonical, alternates = [], ogImage, robots, jsonLd = [], languageTwin } = Astro.props;
const ogTitle = Astro.props.ogTitle ?? title;
const ogDescription = Astro.props.ogDescription ?? description;
const image = new URL(ogImage.path, SITE_URL).href;

// Google Consent Mode v2: `gtag` and the consent defaults (all denied, or the stored choice) come first
// in <head> (src/lib/consent.ts), so gtag.js and the config calls below never run without them.
// With analytics_storage / ad_storage denied the Google tags set no cookies.
// `gtag` stays global so pages can send events (see the /ai-skoleni form).
// gtag.js itself loads after the page (load + idle), off the critical path. The calls above queue in
// dataLayer until then, after the consent defaults, so Consent Mode stays "advanced" (cookieless pings
// while denied) and nothing is sent before the defaults apply.
const GTAG_SNIPPET = `
      gtag('js', new Date());
      gtag('config', '${GA_MEASUREMENT_ID}');
      (function () {
        function load() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}';
          document.head.appendChild(s);
        }
        function idle() { 'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 3000 }) : setTimeout(load, 1500); }
        document.readyState === 'complete' ? idle() : addEventListener('load', idle, { once: true });
      })();
    `;

// Only the text face of headings and copy is preloaded (Czech needs latin-ext for č, ř, ů…). The mono
// face (labels, eyebrows) loads on demand with font-display: swap instead of competing for the first bytes.
const PRELOAD_FONTS = ["jost-latin", "jost-latin-ext"];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={consentHeadSnippet()} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {PRELOAD_FONTS.map((font) => <link rel="preload" href={`/fonts/${font}.woff2`} as="font" crossorigin="" type="font/woff2" />)}
    <meta name="theme-color" content="#0B1220" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="sivak.ai" />
    <meta property="og:locale" content={lang === "cs" ? "cs_CZ" : "en_US"} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <slot name="head" />
  </head>
  <body>
    <CookieConsent lang={lang} />
    {languageTwin && <LanguageHint href={languageTwin} lang={lang === "cs" ? "en" : "cs"} />}
    <slot />
    {/* Plain spaces in structured data: the Czech copy's no-break spaces are only for line breaking */}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replaceAll("\u00a0", " ").replaceAll("<", "\\u003c")} />)}
    <script is:inline set:html={GTAG_SNIPPET} />
    <slot name="end" />
    <script>
      import { setupLanguage } from "@/components/language-hint";

      setupLanguage();
    </script>
  </body>
</html>
