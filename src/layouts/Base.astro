---
import "@/styles/fonts.css";
import "@/styles/global.css";
import Document from "./Document.astro";

// The earlier design's layout (training landing page, old service pages, privacy policy, 404):
// the shared document shell plus that design's fonts and stylesheet.
type Props = Omit<import("astro/types").ComponentProps<typeof Document>, "preloadFonts" | "themeColor">;

// Only the text face of headings and copy is preloaded (Czech needs latin-ext for č, ř, ů…). The mono
// face (labels, eyebrows) loads on demand with font-display: swap instead of competing for the first bytes.
const PRELOAD_FONTS = ["jost-latin", "jost-latin-ext"];
---
<Document {...Astro.props} preloadFonts={PRELOAD_FONTS}>
  <slot name="head" slot="head" />
  <slot />
  <slot name="end" slot="end" />
</Document>
