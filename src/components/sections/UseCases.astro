---
import Eyebrow from "../Eyebrow.astro";
import Icon from "../Icon.astro";
import type { Home } from "@/lib/content";

interface Props {
  t: Home["useCases"];
  contactHref: string;
}
const { t, contactHref } = Astro.props;
---
<section class="section dark usecases" id={t.id} aria-labelledby={`${t.id}-title`}>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head reveal">
      <Eyebrow index="03">{t.eyebrow}</Eyebrow>
      <h2 class="section-title" id={`${t.id}-title`}>{t.title}</h2>
      <p class="section-lead">{t.lead}</p>
    </div>
    <ol class="uc-list reveal">
      {
        t.items.map((item, i) => (
          <li class="uc-row">
            <span class="uc-num" aria-hidden="true">0{i + 1}</span>
            <h3 class="uc-area">{item.area}</h3>
            <p class="uc-text">{item.text}</p>
            <p class="uc-output"><span>{t.outputLabel}</span>{item.output}</p>
          </li>
        ))
      }
    </ol>
    <p class="uc-more reveal"><span>{t.more}</span><a href={contactHref}>{t.moreLink}<Icon name="arrow" /></a></p>
  </div>
</section>
