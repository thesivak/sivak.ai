---
import { LOGO_VIEWBOX, MARK, WORDMARK, WORDMARK_TRANSFORM } from "./logo";
// The full logo (doorway mark and wordmark) as one inline SVG in the current text colour.
---
<svg viewBox={LOGO_VIEWBOX} fill="currentColor" aria-hidden="true" focusable="false"><path d={MARK}></path><path d={WORDMARK} transform={WORDMARK_TRANSFORM}></path></svg>
