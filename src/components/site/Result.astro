---
import PreviewTag from "./PreviewTag.astro";
import type { Link, Result } from "@/site";

// One hard result with a number, set like a step: the figure, what it counts, one sentence of context.
interface Props extends Result {
  id: string;
  /** The figure is not confirmed yet: the section carries the preview tag */
  preview?: boolean;
  link?: Link;
}
const { id, title, lead, figure, unit, note, preview, link } = Astro.props;
---
<section class="band band-sheet" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="head">
      {preview && <p class="preview-line"><PreviewTag /></p>}
      <h2 class="h2" id={`${id}-title`}>{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <ul class="points points-3">
      <li>
        <span class="steps-num">{figure}</span>
        <h3 class="h3">{unit}</h3>
        <p>{note}</p>
      </li>
    </ul>
    {link && <p class="actions"><a class="link" href={link.href}>{link.label}</a></p>}
  </div>
</section>
