---
import Shell from "./Shell.astro";
import AgentGain from "./AgentGain.astro";
import Questions from "./Questions.astro";
import Steps from "./Steps.astro";
import ContactBlock from "./ContactBlock.astro";
import { localePath, type Locale } from "@/i18n/config";
import { SECTION_IDS } from "@/i18n/sections";
import { homeJsonLd, meetingHref } from "@/lib/site";
import { getSite } from "@/site";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = getSite(lang);
const h = t.home;
const other: Locale = lang === "cs" ? "en" : "cs";
// The index under the hero: named offers when the language has them, else the services
const offers = h.services.items ?? t.services.map((service) => ({ title: service.name, href: service.path, text: service.summary, points: service.offers.items.map((item) => item.title) }));
const services = t.services.map((service) => ({ name: service.name, description: service.summary, path: service.path }));
---
<Shell lang={lang} title={h.metadata.title} description={h.metadata.description} path={localePath(lang)} twinPath={localePath(other)} jsonLd={[homeJsonLd(lang, services)]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 class="display" id="hero-title">{h.hero.title.map((line) => <span>{line} </span>)}</h1>
      <div class="hero-copy">
        <p class="lead">{h.hero.lead}</p>
        <div class="actions">
          {h.hero.cta ? (
            <>
              <a class="btn" href={meetingHref(h.hero.cta[0].subject)}>{h.hero.cta[0].label}</a>
              <a class="link" href={meetingHref(h.hero.cta[1].subject)}>{h.hero.cta[1].label}</a>
            </>
          ) : (
            <>
              <a class="btn" href={`#${h.contact.id}`}>{h.hero.primary}</a>
              <a class="link" href={`#${h.services.id}`}>{h.hero.secondary}</a>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <AgentGain t={h.gain} />

  {
    h.audience && (
      <section class="band band-sheet" id={h.audience.id} aria-labelledby={`${h.audience.id}-title`}>
        <div class="wrap">
          <div class="head">
            <h2 class="h2" id={`${h.audience.id}-title`}>{h.audience.title}</h2>
            <p class="lead">{h.audience.lead}</p>
          </div>
          <ul class="index">
            {h.audience.items.map((item) => (
              <li class="index-row">
                <h3 class="index-name">{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
                <p class="index-text">{item.text}</p>
                <ul class="index-items">{item.points.map((point) => <li>{point}</li>)}</ul>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* What we do: the three services, each a row linking to its page */}
  <section class="band" id={h.pillars.id} aria-labelledby={`${h.pillars.id}-title`}>
    <div class="wrap">
      <div class="head">
        <h2 class="h2" id={`${h.pillars.id}-title`}>{h.pillars.title}</h2>
        <p class="lead">{h.pillars.lead}</p>
      </div>
      <ul class="index">
        {
          t.services.map((service) => (
            <li class="index-row">
              <h3 class="index-name"><a href={service.path}>{service.name}</a></h3>
              <p class="index-text">{service.summary}</p>
              <ul class="index-items">{service.offers.items.map((item) => <li>{item.title}</li>)}</ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* The offers stand on the sheet unless the audience index above already does */}
  <section class:list={["band", { "band-sheet": !h.audience }]} id={h.services.id} aria-labelledby={`${h.services.id}-title`}>
    <div class="wrap">
      <div class="head">
        <h2 class="h2" id={`${h.services.id}-title`}>{h.services.title}</h2>
        {h.services.lead && <p class="lead">{h.services.lead}</p>}
      </div>
      <ul class:list={["index", { "index-offers": h.services.items }]}>
        {
          offers.map((item) => (
            <li class="index-row">
              <h3 class="index-name">{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
              <p class="index-text">{item.text}</p>
              <ul class="index-items">{item.points.map((point) => <li>{point}</li>)}</ul>
            </li>
          ))
        }
      </ul>
      {h.services.link && <p class="actions"><a class="link" href={h.services.link.href}>{h.services.link.label}</a></p>}
    </div>
  </section>

  <section class="band" aria-labelledby="why-title">
    <div class="wrap">
      <h2 class="h2" id="why-title">{h.why.title}</h2>
      <ul class:list={["points", h.why.items.length % 3 === 0 ? "points-3" : "points-4"]}>
        {h.why.items.map((item) => <li><h3 class="h3">{item.title}</h3><p>{item.text}</p></li>)}
      </ul>
    </div>
  </section>

  {
    h.notDoing && (
      <section class="band" id={h.notDoing.id} aria-labelledby={`${h.notDoing.id}-title`}>
        <div class="wrap">
          <div class="head">
            <h2 class="h2" id={`${h.notDoing.id}-title`}>{h.notDoing.title}</h2>
            {h.notDoing.lead && <p class="lead">{h.notDoing.lead}</p>}
          </div>
          <ul class:list={["points", h.notDoing.items.length % 3 === 0 ? "points-3" : "points-4"]}>
            {h.notDoing.items.map((item) => <li><h3 class="h3">{item.title}</h3><p>{item.text}</p></li>)}
          </ul>
          {h.notDoing.link && <p class="actions"><a class="link" href={h.notDoing.link.href}>{h.notDoing.link.label}</a></p>}
        </div>
      </section>
    )
  }

  <section class="band band-ink" id={h.work.id} aria-labelledby={`${h.work.id}-title`}>
    <div class="wrap">
      <div class="head">
        <h2 class="h2" id={`${h.work.id}-title`}>{h.work.title}</h2>
        <p class="lead">{h.work.lead}</p>
      </div>
      <table class="work">
        <thead>
          <tr>{h.work.columns.map((column) => <th scope="col">{column}</th>)}</tr>
        </thead>
        <tbody>
          {h.work.agents.map((agent) => <tr><th scope="row">{agent.name}</th><td>{agent.text}</td><td>{agent.meta}</td></tr>)}
        </tbody>
      </table>
      <ul class="work-facts">{h.work.facts.map((fact) => <li>{fact}</li>)}</ul>
      {h.work.link && <p class="actions"><a class="link" href={h.work.link.href}>{h.work.link.label}</a></p>}
    </div>
  </section>

  <Questions id={h.questions.id} title={h.questions.title} items={h.questions.items} />
  <Steps id={h.process.id} title={h.process.title} lead={h.process.lead} steps={h.process.steps} from={h.process.from} link={h.process.link} />
  <ContactBlock lang={lang} id={h.contact.id} title={h.contact.title} lead={h.contact.lead} mailSubject={h.contact.mailSubject} actions={h.contact.cta} />
  {/* A section link in the other language's words ("/en#sluzby") lands on this page's section */}
  <script is:inline define:vars={{ sectionIds: SECTION_IDS, lang }}>
    (() => {
      const normalizeHash = () => {
        let id;
        try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
        if (!id || document.getElementById(id)) return;
        const pair = sectionIds.find((pair) => pair.cs === id || pair.en === id);
        const target = pair && document.getElementById(pair[lang]);
        if (!target) return;
        history.replaceState(history.state, "", location.pathname + location.search + "#" + pair[lang]);
        target.scrollIntoView();
      };
      normalizeHash();
      window.addEventListener("hashchange", normalizeHash);
    })();
  </script>
</Shell>
