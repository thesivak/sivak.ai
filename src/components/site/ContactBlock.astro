---
import type { Locale } from "@/i18n/config";
import EnquiryButton from "./EnquiryButton.astro";
import { PEOPLE, telHref } from "@/lib/site";
import { getSite, type Cta } from "@/site";

interface Props {
  lang: Locale;
  id: string;
  title: string;
  lead: string;
  mailSubject: string;
  /** The buttons (they open the enquiry dialog), the first one filled; default: the site-wide call to action */
  actions?: Cta[];
}
const { lang, id, title, lead, mailSubject } = Astro.props;
const t = getSite(lang);
const [main, ...more] = Astro.props.actions ?? [{ label: t.nav.cta, subject: mailSubject }];
---
<section class="band contact" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap contact-grid">
    <div>
      <h2 class="h2" id={`${id}-title`}>{title}</h2>
      <p class="lead">{lead}</p>
      <div class="actions">
        <EnquiryButton label={main.label} place={id} />
        {more.map((action) => <EnquiryButton label={action.label} place={id} class="link" />)}
      </div>
    </div>
    <ul class="people">
      {
        PEOPLE.map((person) => (
          <li>
            <h3 class="h3">{person.name}</h3>
            <p class="people-role">{person.role}</p>
            <ul>
              <li><a href={`mailto:${person.email}`}><span class="sr-only">{t.shared.emailLabel}: </span>{person.email}</a></li>
              {person.phone && <li><a href={telHref(person.phone)}><span class="sr-only">{t.shared.phoneLabel}: </span>{person.phone}</a></li>}
              {person.linkedin && <li><a href={person.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>}
              <li><a href={person.vcard} download>{t.shared.saveContact}</a></li>
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
