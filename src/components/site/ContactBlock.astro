---
import type { Locale } from "@/i18n/config";
import { PEOPLE, meetingHref, telHref } from "@/lib/site";
import { getSite } from "@/site";

interface Props {
  lang: Locale;
  id: string;
  title: string;
  lead: string;
  mailSubject: string;
}
const { lang, id, title, lead, mailSubject } = Astro.props;
const t = getSite(lang);
---
<section class="band contact" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap contact-grid">
    <div>
      <h2 class="h2" id={`${id}-title`}>{title}</h2>
      <p class="lead">{lead}</p>
      <a class="btn contact-btn" href={meetingHref(mailSubject)}>{t.nav.cta}</a>
    </div>
    <ul class="people">
      {
        PEOPLE.map((person) => (
          <li>
            <h3 class="h3">{person.name}</h3>
            <p class="people-role">{person.role}</p>
            <ul>
              <li><a href={`mailto:${person.email}`}><span class="sr-only">{t.shared.emailLabel}: </span>{person.email}</a></li>
              {person.phone && <li><a href={telHref(person.phone)}><span class="sr-only">{t.shared.phoneLabel}: </span>{person.phone}</a></li>}
              {person.linkedin && <li><a href={person.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>}
              <li><a href={person.vcard} download>{t.shared.saveContact}</a></li>
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
